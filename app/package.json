{
  "name": "ggpoker-desktop-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"GGPOKER_DEV=1 node server/index.js\" \"vite --port 5199 --strictPort\"",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "desktop:dev": "GGPOKER_DEV=1 electron electron/main.cjs",
    "desktop": "electron electron/main.cjs",
    "test": "node --test server/*.test.js",
    "prebuild": "node ../tools/copy_ruffle.mjs",
    "predev": "node ../tools/copy_ruffle.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
