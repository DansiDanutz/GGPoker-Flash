# Prefer tools/openpoker-install.sh init: it creates .env with a random password
# and your full source commit. This file contains no usable production password.
OPENPOKER_PROJECT=openpoker
OPENPOKER_PORT=5198
OPENPOKER_SITE_NAME='OpenPoker'
OPENPOKER_SITE_ORIGIN=http://localhost:5198
OPENPOKER_SITE_LOGO=
OPENPOKER_SITE_ICON=
OPENPOKER_SITE_IMAGE=
OPENPOKER_SUPPORT_EMAIL=

# Keep the project name stable: it identifies the persistent game-data volume.
# Rebuild with tools/openpoker-install.sh up after editing public identity.
GIT_SHA=
SOURCE_REPOSITORY=https://github.com/OpenPoker4all/OpenPoker

# Required on the first production start. Existing accounts are not reset.
GGPOKER_ADMIN_PASSWORD=
GGPOKER_ADMIN_ALLOW=127.0.0.1,::1,172.16.0.0/12

# Only set to 1 behind an edge proxy that replaces client-supplied forwarding
# headers. See Caddyfile.example; the app's host port must remain loopback-only.
GGPOKER_TRUST_PROXY=0
