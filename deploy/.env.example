# Copy to .env and keep it out of git.
DOMAIN=dangg.live

# Origins accepted by the game server (Caddy forwards the public host).
GGPOKER_PUBLIC_ORIGIN=https://dangg.live

# Caddy terminates TLS and forwards the real client address.
GGPOKER_TRUST_PROXY=1

# Admin API is reachable only from the Tailscale CGNAT range and localhost.
# Replace/extend with the exact Mac Studio tailnet address if desired.
GGPOKER_ADMIN_ALLOW=127.0.0.1/32,::1,172.16.0.0/12,100.64.0.0/10

# Production flags.
NODE_ENV=production
PORT=5198

# Required on first production start (at least 16 characters). Change it before
# exposing the server; admin login is `admin` with this password.
GGPOKER_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
GGPOKER_SEED_DEMO=0
