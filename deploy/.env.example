# Copy to .env and keep it out of git.
DOMAIN=dangg.live

# Origins accepted by the game server (the shared Traefik edge forwards the public host).
GGPOKER_PUBLIC_ORIGIN=https://dangg.live
GGPOKER_ALLOWED_HOSTS=www.dangg.live

# The shared Traefik edge terminates TLS and forwards the real client address.
GGPOKER_TRUST_PROXY=1

# Admin API is reachable only from the Tailscale CGNAT range and localhost.
# Replace/extend with the exact Mac Studio tailnet address if desired.
GGPOKER_ADMIN_ALLOW=127.0.0.1/32,::1,172.16.0.0/12,100.64.0.0/10

# Production flags.
NODE_ENV=production
PORT=5198

# Required on first production start (at least 16 characters). Change it before
# exposing the server; admin login is `admin` with this password.
GGPOKER_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
GGPOKER_SEED_DEMO=0

# Hosted organizer management: off preserves community/self-hosted behaviour;
# observe audits missing purchases; enforce requires paid plugin access.
# Before enabling enforce, configure prices, publisher credits and paid access
# using the private Marketplace finance console. This does not enable checkout.
GGPOKER_MARKETPLACE_ENFORCEMENT=off

# New organizer service credits and memberships; keep off until the new tariff
# and real funding workflow are verified. Reconcile legacy paid access first.
GGPOKER_USAGE_BILLING=off
